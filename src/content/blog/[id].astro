---
import { getCollection } from 'astro:content';

// 1. توليد المسارات لكل المقالات الموجودة في مجلد blog
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

// 2. استقبال المقال الخاص بهذه الصفحة
const { post } = Astro.props;
const { Content } = await post.render();
---

<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>{post.data.title}</title>
  <meta name="description" content={post.data.description || ''} />
</head>
<body>
  <main style="max-width: 800px; margin: 40px auto; padding: 0 20px; font-family: sans-serif;">
    <p><a href="/">← العودة للرئيسية</a></p>
    
    <article>
      <h1>{post.data.title}</h1>
      <p style="color: #666; font-size: 0.9rem;">
        {new Date(post.data.date).toLocaleDateString('ar-SA')}
      </p>
      
      {post.data.image && (
        <img src={post.data.image} alt={post.data.title} style="max-width: 100%; height: auto; border-radius: 8px;" />
      )}
      
      <hr style="margin: 20px 0; border: 0; border-top: 1px solid #eee;" />

      <!-- هنا يتم عرض محتوى المقال المكتوب بالماركداون تلقائياً -->
      <div class="content">
        <Content />
      </div>
    </article>
  </main>
</body>
</html>
